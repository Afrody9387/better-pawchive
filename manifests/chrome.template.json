{
  "manifest_version": 3,
  "name": "Better Pawchive",
  "version": "2.3.1",
  "description": "Quickly favorite creators, jump to Pawchive from source sites, and track viewed posts.",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "64": "icons/logo-64.png",
    "128": "icons/logo-128.png"
  },
  "action": {
    "default_title": "Open Better Pawchive",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": []
    }
  ]
}
