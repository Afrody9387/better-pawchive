{
  "manifest_version": 3,
  "name": "Better Pawchive",
  "version": "2.4.0",
  "description": "Quickly favorite creators, jump to Pawchive from source sites, and track viewed posts.",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://coomer.st/*",
    "https://kemono.cr/*",
    "https://pawchive.pw/*",
    "https://*.patreon.com/*",
    "https://*.fanbox.cc/*",
    "https://www.pixiv.net/*",
    "https://discord.com/channels/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://coomer.st/*",
        "https://kemono.cr/*",
        "https://pawchive.pw/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    },
    {
      "matches": [
        "https://*.patreon.com/*",
        "https://*.fanbox.cc/*",
        "https://www.pixiv.net/*",
        "https://discord.com/channels/*"
      ],
      "js": [
        "jump.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "64": "icons/logo-64.png",
    "128": "icons/logo-128.png"
  },
  "action": {
    "default_title": "Open Better Pawchive",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "https://coomer.st/*",
        "https://kemono.cr/*",
        "https://pawchive.pw/*"
      ]
    }
  ]
}