{
  "manifest_version": 2,
  "name": "Better Pawchive",
  "version": "2.3.1",
  "description": "Quickly favorite creators, jump to Pawchive from source sites, and track viewed posts.",
  "permissions": [
    "tabs",
    "storage",
    "https://coomer.st/*",
    "https://kemono.cr/*",
    "https://pawchive.pw/*",
    "https://*.patreon.com/*",
    "https://*.fanbox.cc/*",
    "https://www.pixiv.net/*",
    "https://discord.com/channels/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://coomer.st/*",
        "https://kemono.cr/*",
        "https://pawchive.pw/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.patreon.com/*",
        "https://*.fanbox.cc/*",
        "https://www.pixiv.net/*",
        "https://discord.com/channels/*"
      ],
      "js": [
        "jump.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "64": "icons/logo-64.png",
    "128": "icons/logo-128.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png"
    }
  },
  "web_accessible_resources": [
    "inject.js"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{7e5e11c3-21a8-4edd-9fce-a28267f9303c}",
      "strict_min_version": "109.0"
    }
  }
}